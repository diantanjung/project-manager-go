# Copy this file to .env.production and replace every CHANGE_ME value.
NODE_ENV=production
PORT=3000
DATABASE_URL=CHANGE_ME_POSTGRES_URL_WITH_TLS
FRONTEND_URL=https://CHANGE_ME_FRONTEND_DOMAIN
JWT_SECRET=CHANGE_ME_RANDOM_SECRET
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_RANDOM_SECRET
JWT_REFRESH_EXPIRES_IN=7d
# Use a persistent directory or mounted volume for uploaded files.
UPLOAD_DIR=uploads
